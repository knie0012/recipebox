import ipaddress
import socket
from urllib.parse import urlparse

import requests
from recipe_scrapers import scrape_html


class RecipeImportError(Exception):
    """Raised when a recipe cannot be safely imported."""


MAX_HTML_BYTES = 5 * 1024 * 1024

REQUEST_TIMEOUT = (
    5,
    15,
)

USER_AGENT = (
    "RecipeBox/1.0 "
    "(personal recipe importer)"
)


def validate_public_url(url):
    """
    Validate that a URL uses HTTP or HTTPS and resolves only
    to public network addresses.
    """

    parsed = urlparse(url)

    if parsed.scheme not in {"http", "https"}:
        raise RecipeImportError(
            "Only HTTP and HTTPS recipe URLs are supported."
        )

    if not parsed.hostname:
        raise RecipeImportError(
            "Enter a complete recipe URL."
        )

    try:
        address_info = socket.getaddrinfo(
            parsed.hostname,
            parsed.port or (
                443 if parsed.scheme == "https" else 80
            ),
            type=socket.SOCK_STREAM,
        )
    except socket.gaierror as error:
        raise RecipeImportError(
            "The recipe website could not be found."
        ) from error

    for address in address_info:
        ip_text = address[4][0]

        try:
            ip_address = ipaddress.ip_address(ip_text)
        except ValueError as error:
            raise RecipeImportError(
                "The recipe website resolved to an invalid address."
            ) from error

        if (
            ip_address.is_private
            or ip_address.is_loopback
            or ip_address.is_link_local
            or ip_address.is_multicast
            or ip_address.is_reserved
            or ip_address.is_unspecified
        ):
            raise RecipeImportError(
                "That URL points to a private or unsupported address."
            )


def fetch_recipe_html(url):
    """
    Download recipe HTML with a timeout and response-size limit.
    """

    validate_public_url(url)

    try:
        response = requests.get(
            url,
            headers={
                "User-Agent": USER_AGENT,
                "Accept": (
                    "text/html,"
                    "application/xhtml+xml"
                ),
            },
            timeout=REQUEST_TIMEOUT,
            stream=True,
            allow_redirects=True,
        )
    except requests.RequestException as error:
        raise RecipeImportError(
            "The recipe website could not be reached."
        ) from error

    try:
        response.raise_for_status()

        content_type = response.headers.get(
            "Content-Type",
            "",
        ).lower()

        if (
            "text/html" not in content_type
            and "application/xhtml+xml" not in content_type
        ):
            raise RecipeImportError(
                "The URL did not return a webpage."
            )

        chunks = []
        downloaded_bytes = 0

        for chunk in response.iter_content(
            chunk_size=64 * 1024
        ):
            if not chunk:
                continue

            downloaded_bytes += len(chunk)

            if downloaded_bytes > MAX_HTML_BYTES:
                raise RecipeImportError(
                    "The recipe webpage is too large to import."
                )

            chunks.append(chunk)

        encoding = response.encoding or "utf-8"

        return (
            b"".join(chunks).decode(
                encoding,
                errors="replace",
            ),
            response.url,
        )

    finally:
        response.close()


def safe_scraper_value(
    function,
    default=None,
    field_name="unknown",
):
    try:
        value = function()

    except Exception:
        current_app.logger.exception(
            "Recipe import field failed: %s",
            field_name,
        )
        return default

    return value if value not in ("", [], {}) else default

def normalize_instruction_list(scraper):
    """
    Return instructions as a clean list of step strings.
    """

    instruction_list = safe_scraper_value(
        scraper.instructions_list,
        default=None,
    )

    if instruction_list:
        return [
            str(instruction).strip()
            for instruction in instruction_list
            if str(instruction).strip()
        ]

    instructions = safe_scraper_value(
        scraper.instructions,
        default="",
    )

    if not instructions:
        return []

    return [
        line.strip()
        for line in str(instructions).splitlines()
        if line.strip()
    ]


def extract_recipe_from_url(url):
    """
    Fetch and extract a recipe into temporary review data.
    """

    html, final_url = fetch_recipe_html(url)

    try:
        scraper = scrape_html(
            html,
            org_url=final_url,
        )
    except Exception as error:
        raise RecipeImportError(
            "A recipe could not be detected on that webpage."
        ) from error

    title = safe_scraper_value(
    scraper.title,
    default="",
    field_name="title",
    )

    ingredients = safe_scraper_value(
        scraper.ingredients,
        default=[],
    )

    steps = normalize_instruction_list(scraper)

    if not title:
        raise RecipeImportError(
            "The webpage did not provide a recipe title."
        )

    if not ingredients:
        raise RecipeImportError(
            "The webpage did not provide an ingredient list."
        )

    if not steps:
        raise RecipeImportError(
            "The webpage did not provide recipe instructions."
        )

    return {
        "source_url": final_url,
        "title": str(title).strip(),
        "description": safe_scraper_value(
            scraper.description,
            default="",
        ),
        "prep_time": safe_scraper_value(
            scraper.prep_time,
        ),
        "cook_time": safe_scraper_value(
            scraper.cook_time,
        ),
        "servings_text": safe_scraper_value(
            scraper.yields,
            default="",
        ),
        "image_url": safe_scraper_value(
            scraper.image,
            default="",
        ),
        "ingredients": [
            {
                "original_text": str(item).strip(),
            }
            for item in ingredients
            if str(item).strip()
        ],
        "steps": [
            {
                "instruction": instruction,
            }
            for instruction in steps
        ],
    }