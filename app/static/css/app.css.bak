:root {
    --background: #f6f6f4;
    --surface: #ffffff;
    --text: #222222;
    --muted: #676767;
    --border: #deded8;
    --primary: #315f42;
    --primary-hover: #244a32;
    --danger: #a52a2a;
    --danger-hover: #801f1f;
    --success-background: #e7f5ea;
    --success-border: #80b88b;
    --error-background: #fbe8e8;
    --error-border: #d49292;
}

* {
    box-sizing: border-box;
}

html {
    font-size: 16px;
}

body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family:
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    line-height: 1.5;
}

a {
    color: var(--primary);
}

.container {
    width: min(100% - 2rem, 900px);
    margin-inline: auto;
}

.site-header {
    margin-bottom: 1.5rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
}

.header-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    padding-bottom: 1rem;
}

.site-title {
    color: var(--text);
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
}

.main-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
}

.main-nav a {
    font-weight: 600;
    text-decoration: none;
}

.nav-user {
    color: var(--muted);
    font-size: 0.9rem;
}

.nav-form {
    display: inline;
}

.nav-button {
    padding: 0;
    background: none;
    color: var(--primary);
    border: 0;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
}

.nav-button:hover {
    text-decoration: underline;
}

.page-heading {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.card {
    margin-bottom: 1rem;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
}

.recipe-list {
    display: grid;
    gap: 1rem;
}

.recipe-card {
    overflow: hidden;
    padding: 0;
}

.recipe-card h2,
.recipe-card h3 {
    margin-top: 0;
}

.recipe-card-content {
    padding: 1rem;
}

.recipe-meta {
    color: var(--muted);
}

.recipe-thumbnail-link {
    display: block;
}

.recipe-thumbnail {
    display: block;
    width: 100%;
    height: 190px;
    object-fit: cover;
}

.recipe-thumbnail-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 190px;
    background: #e7e7e2;
    color: var(--muted);
    font-weight: 600;
}

.button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.65rem 1rem;
    background: var(--primary);
    color: white;
    border: 0;
    border-radius: 0.5rem;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
}

.button:hover {
    background: var(--primary-hover);
}

.button-secondary {
    background: #666666;
}

.button-secondary:hover {
    background: #4d4d4d;
}

.button-danger {
    background: var(--danger);
}

.button-danger:hover {
    background: var(--danger-hover);
}

.button-small {
    min-height: 38px;
    padding: 0.45rem 0.75rem;
    font-size: 0.9rem;
}

form {
    margin: 0;
}

.form-group {
    margin-bottom: 1.25rem;
}

.form-row {
    display: grid;
    gap: 1rem;
}

label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 600;
}

fieldset.form-group {
    min-width: 0;
    padding: 0;
    border: 0;
}

fieldset.form-group legend {
    padding: 0;
    font-weight: 600;
}

input,
select,
textarea {
    width: 100%;
    min-height: 44px;
    padding: 0.7rem;
    background: white;
    border: 1px solid #a9a9a4;
    border-radius: 0.4rem;
    color: var(--text);
    font: inherit;
}

textarea {
    min-height: 110px;
    resize: vertical;
}

input:focus,
select:focus,
textarea:focus {
    outline: 3px solid rgba(49, 95, 66, 0.2);
    border-color: var(--primary);
}

.field-help {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.9rem;
}

.checkbox-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
}

.checkbox-label input {
    width: auto;
    min-height: auto;
    padding: 0;
    margin: 0;
    accent-color: var(--primary);
}

.checkbox-grid {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(150px, 1fr)
    );
    gap: 0.75rem;
    margin-top: 0.75rem;
}

.checkbox-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0;
    padding: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    cursor: pointer;
}

.checkbox-option:hover {
    background: var(--background);
}

.checkbox-option:focus-within {
    outline: 3px solid rgba(49, 95, 66, 0.2);
    border-color: var(--primary);
}

.checkbox-option:has(input:checked) {
    background: var(--success-background);
    border-color: var(--success-border);
}

.checkbox-option input {
    width: auto;
    min-height: auto;
    padding: 0;
    margin: 0;
    accent-color: var(--primary);
}

.flash-container {
    margin-bottom: 1rem;
}

.flash {
    margin-bottom: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid;
    border-radius: 0.5rem;
}

.flash-success {
    background: var(--success-background);
    border-color: var(--success-border);
}

.flash-error {
    background: var(--error-background);
    border-color: var(--error-border);
}

.muted {
    color: var(--muted);
}

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.ingredient-list {
    padding: 0;
    list-style: none;
}

.ingredient-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
}

.ingredient-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.ingredient-description {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
}

.ingredient-name {
    text-transform: capitalize;
}

.ingredient-section-heading {
    margin-top: 1rem;
    padding: 0.6rem 0;
    border-bottom: 2px solid var(--border);
    font-size: 1.1rem;
    font-weight: 700;
    list-style: none;
}

.ingredient-section-heading:first-child {
    margin-top: 0;
}

.step-list {
    padding-left: 1.5rem;
}

.step-item {
    margin-bottom: 1rem;
    padding: 0 0 1rem 0.5rem;
    border-bottom: 1px solid var(--border);
}

.step-content p:first-child {
    margin-top: 0;
}

.recipe-gallery {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
}

.recipe-image-card {
    margin: 0;
    overflow: hidden;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
}

.recipe-image {
    display: block;
    width: 100%;
    max-height: 500px;
    object-fit: cover;
}

.recipe-image-card figcaption {
    padding: 0.75rem 1rem;
}

.photo-actions {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    padding: 0 1rem 1rem;
}

.photo-actions form {
    display: flex;
    margin: 0;
    padding: 0;
}

.photo-action-button {
    width: 125px;
    min-width: 125px;
    height: 38px;
    min-height: 38px;
    padding: 0.45rem 0.75rem;
}

.photo-upload-form {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
}

.image-edit-preview {
    margin-bottom: 1.5rem;
    border-radius: 0.5rem;
}

.login-container {
    width: min(100%, 480px);
    margin-inline: auto;
}

.login-card {
    margin-top: 2rem;
}

.recipe-audit-summary {
    margin-bottom: 1.5rem;
}

.recipe-audit-summary p {
    margin: 0.4rem 0;
}

.history-list {
    margin: 0;
    padding: 0;
    list-style: none;
}

.history-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
}

.history-item:first-child {
    padding-top: 0;
}

.history-item:last-child {
    padding-bottom: 0;
    border-bottom: 0;
}

.history-heading {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
}

.history-details {
    margin-top: 0.35rem;
}

.history-date {
    margin-top: 0.3rem;
    font-size: 0.9rem;
}

.import-list {
    display: grid;
    gap: 1rem;
}

.import-item {
    padding: 1rem;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
}

.import-item .form-group:last-child {
    margin-bottom: 0;
}

.import-ingredient-grid {
    display: grid;
    gap: 1rem;
}

.import-preview-image {
    margin-bottom: 1rem;
    border-radius: 0.5rem;
}

.danger-zone {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
}

@media (min-width: 650px) {
    .header-content {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .page-heading {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .form-row {
        grid-template-columns: 1fr 1fr;
    }

    .ingredient-item {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
    }

    .step-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .step-content {
        flex: 1;
    }

    .recipe-gallery {
        grid-template-columns: repeat(
            auto-fit,
            minmax(240px, 1fr)
        );
    }

    .recipe-card {
        display: grid;
        grid-template-columns: 220px 1fr;
    }

    .recipe-thumbnail,
    .recipe-thumbnail-placeholder {
        height: 100%;
        min-height: 180px;
    }

    .history-heading {
        flex-direction: row;
        gap: 0.4rem;
    }

    .import-ingredient-grid {
        grid-template-columns:
            minmax(90px, 0.55fr)
            minmax(140px, 0.8fr)
            minmax(140px, 1fr)
            minmax(220px, 1.8fr);
    }
}

/* =========================================================
   Manage classifications
   ========================================================= */

.classifications-page {
    max-width: 1050px;
    margin: 0 auto;
    padding: 1.5rem;
}

.page-header {
    margin-bottom: 2rem;
}

.page-header h1 {
    margin: 0 0 0.4rem;
}

.page-description {
    margin: 0;
    color: #666;
}

.classification-section {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 10px;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
}

.section-heading h2 {
    margin: 0 0 0.25rem;
}

.section-heading p {
    margin: 0;
    color: #666;
}

.classification-count {
    flex-shrink: 0;
    padding: 0.35rem 0.7rem;
    font-size: 0.9rem;
    background: #f1f1f1;
    border-radius: 999px;
}

.classification-add-form {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: #f7f7f7;
    border-radius: 8px;
}

.classification-add-form label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
}

.add-form-controls {
    display: flex;
    gap: 0.65rem;
}

.add-form-controls input {
    flex: 1;
    min-width: 0;
}

.classification-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
}

.classification-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem;
    border: 1px solid #ddd;
    border-radius: 8px;
}

.tag-item {
    grid-template-columns: minmax(0, 1fr) auto;
}

.classification-order-controls {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.classification-order-controls form,
.classification-delete-form {
    margin: 0;
}

.icon-button {
    width: 2rem;
    height: 1.7rem;
    padding: 0;
    line-height: 1;
    cursor: pointer;
    background: #f5f5f5;
    border: 1px solid #ccc;
    border-radius: 4px;
}

.icon-button:hover:not(:disabled) {
    background: #e8e8e8;
}

.icon-button:disabled {
    cursor: not-allowed;
    opacity: 0.35;
}

.classification-main {
    min-width: 0;
}

.classification-rename-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
}

.classification-rename-form input {
    flex: 1;
    min-width: 0;
}

.classification-usage {
    margin-top: 0.35rem;
    font-size: 0.85rem;
    color: #666;
}

.classification-add-form input,
.classification-rename-form input {
    padding: 0.6rem 0.7rem;
    font: inherit;
    border: 1px solid #bbb;
    border-radius: 5px;
}

.classification-add-form input:focus,
.classification-rename-form input:focus {
    outline: none;
    border-color: #555;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.08);
}

.button {
    display: inline-block;
    padding: 0.55rem 0.85rem;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    border-radius: 5px;
}

.button-primary {
    color: #fff;
    background: #2463a9;
}

.button-primary:hover {
    background: #1d518c;
}

.button-secondary {
    color: #222;
    background: #eee;
    border-color: #ccc;
}

.button-secondary:hover {
    background: #ddd;
}

.button-danger {
    color: #fff;
    background: #b33434;
}

.button-danger:hover {
    background: #922929;
}

.empty-state {
    padding: 1.5rem;
    text-align: center;
    color: #666;
    background: #f7f7f7;
    border-radius: 8px;
}

.empty-state p {
    margin: 0;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    border: 0;
    clip: rect(0, 0, 0, 0);
}

@media (max-width: 700px) {
    .classifications-page {
        padding: 1rem;
    }

    .classification-section {
        padding: 1rem;
    }

    .section-heading {
        flex-direction: column;
    }

    .classification-item,
    .tag-item {
        grid-template-columns: auto minmax(0, 1fr);
    }

    .tag-item {
        grid-template-columns: minmax(0, 1fr);
    }

    .classification-delete-form {
        grid-column: 2;
    }

    .tag-item .classification-delete-form {
        grid-column: 1;
    }

    .classification-rename-form,
    .add-form-controls {
        flex-direction: column;
        align-items: stretch;
    }

    .classification-delete-form .button {
        width: 100%;
    }
}

/* ---------------------------------------------------------
   Recipe detail classifications
   --------------------------------------------------------- */

.recipe-detail-heading {
    align-items: flex-start;
}

.recipe-heading-content {
    min-width: 0;
}

.recipe-description {
    max-width: 70ch;
}

.recipe-classifications {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1rem;
}

.recipe-type-list,
.recipe-tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
}


/* Recipe Types: prominent primary classifications */

.recipe-type-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 30px;
    padding: 0.35rem 0.75rem;

    background: var(--primary);
    color: #ffffff;

    border: 1px solid var(--primary);
    border-radius: 999px;

    font-size: 0.84rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
}


/* Tags: quieter supporting classifications */

.recipe-tag-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 28px;
    padding: 0.3rem 0.65rem;

    background: transparent;
    color: var(--primary);

    border: 1px solid var(--border);
    border-radius: 999px;

    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
}


/* Small visual marker that distinguishes tags from types */

.recipe-tag-badge::before {
    content: "•";
    margin-right: 0.35rem;
    opacity: 0.65;
}


/* Mobile */

@media (max-width: 649px) {
    .recipe-detail-heading {
        gap: 1rem;
    }

    .recipe-classifications {
        margin-top: 0.85rem;
    }

    .recipe-type-list,
    .recipe-tag-list {
        gap: 0.4rem;
    }
}

.family-card {
    display: grid;
    gap: 1.5rem;
}

.family-card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.family-card-heading h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
}

.family-favorite-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
}

.family-favorite-toggle i {
    font-size: 1.35rem;
}

.family-favorite-toggle:hover,
.family-favorite-toggle:focus-visible {
    text-decoration: underline;
}

.family-favorite-toggle.is-favorite i {
    color: #c0392b;
}

.family-rating-layout {
    display: grid;
    grid-template-columns: minmax(160px, 0.7fr) minmax(280px, 1.3fr);
    gap: 2rem;
    align-items: start;
}

.family-rating-label {
    margin-bottom: 0.45rem;
    font-weight: 700;
}

.family-rating-result {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
}

.rating-average {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
}

.rating-scale {
    font-size: 1rem;
}

.rating-count,
.user-rating-text {
    margin-top: 0.4rem;
}

.rating-stars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
}

.rating-star {
    padding: 0.1rem;
    border: 0;
    background: transparent;
    color: inherit;
    font-size: 1.45rem;
    line-height: 1;
    cursor: pointer;
}

.rating-star:hover,
.rating-star:focus-visible {
    transform: scale(1.12);
}

@media (max-width: 650px) {
    .family-card-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .family-rating-layout {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
}

.family-favorite-toggle i,
.rating-star {
    transition:
        transform 0.15s ease,
        color 0.15s ease;
}

.family-favorite-toggle:hover i {
    transform: scale(1.15);
}

.family-favorite-toggle.is-favorite i {
    color: #c0392b;
}

.rating-star:hover,
.rating-star:focus-visible {
    color: #d49a00;
}

.rating-star:disabled,
.family-favorite-toggle:disabled {
    cursor: wait;
    opacity: 0.65;
}

.average-rating-stars {
    display: flex;
    flex-wrap: wrap;
    gap: 0.12rem;
    margin-bottom: 0.55rem;
    font-size: 1.15rem;
}

.average-rating-stars .bi-star-fill {
    color: #d49a00;
}

.rating-star .bi-star-fill {
    color: #d49a00;
}

.rating-star {
    transition:
        transform 0.15s ease,
        color 0.15s ease,
        opacity 0.15s ease;
}

.rating-star:hover {
    transform: scale(1.13);
}

.rating-star:focus-visible {
    border-radius: 0.2rem;
    outline: 2px solid currentColor;
    outline-offset: 2px;
}

.family-favorite-toggle i {
    transition:
        transform 0.16s ease,
        color 0.16s ease;
}

.family-favorite-toggle:hover i {
    transform: scale(1.15);
}

.family-favorite-toggle.is-favorite i {
    color: #c0392b;
}

.family-favorite-toggle.favorite-pop i {
    animation: favorite-heart-pop 0.35s ease;
}

@keyframes favorite-heart-pop {
    0% {
        transform: scale(1);
    }

    45% {
        transform: scale(1.4);
    }

    70% {
        transform: scale(0.92);
    }

    100% {
        transform: scale(1);
    }
}

.family-card-status {
    min-height: 1.25rem;
    margin-top: -0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(-3px);
    transition:
        opacity 0.2s ease,
        transform 0.2s ease;
}

.family-card-status.is-visible {
    opacity: 1;
    transform: translateY(0);
}

.family-card-status.is-success {
    color: #397447;
}

.family-card-status.is-error {
    color: #b23636;
}

.rating-star:disabled,
.family-favorite-toggle:disabled {
    cursor: wait;
    opacity: 0.55;
}

.recipe-family-summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.9rem;
}

.recipe-family-favorite,
.recipe-index-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
}

.recipe-family-favorite {
    font-weight: 600;
}

.recipe-family-favorite i {
    color: #c0392b;
}

.recipe-index-rating .bi-star-fill {
    color: #d49a00;
}

.recipe-index-rating strong {
    font-weight: 700;
}

.recipe-index-rating-count {
    white-space: nowrap;
}

.recipe-card-title-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
}

.recipe-card-title-row h2 {
    margin: 0;
}

.recipe-title-favorite {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    font-size: 1.15rem;
    line-height: 1;
}

.recipe-title-favorite i {
    color: #c0392b;
}